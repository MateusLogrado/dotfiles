{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "sixel",
    "source": "/home/konata/.config/fastfetch/oda.png",
    "width": 15,
    "height": 10,
    "padding": {
	"top": 3,
	"bottom": 5
    }
  },
  "display": {
    "separator": " ❯ ",
    "color": {
      "title": "#85a7BA",
      "keys": "#85a7BA"
    },
    "key": {
      "width": 14
    }
  },
  "modules": [
    "title",
    {
      "type": "custom",
      "format": "-----System-----"
    },
    {
      "type": "os",
      "key": " OS"
    },
    {
      "type": "kernel",
      "key": " kernel"
    },
    {
      "type": "packages",
      "key": "󰏓 packages"
    },
    {
      "type": "custom",
      "format": "-----Desktop-----"
    },
    {
      "type": "wm",
      "key": "󰍹 WN"
    },
    {
      "type": "terminal",
      "key": " terminal"
    },
    {
      "type": "shell",
      "key": " shell"
    },
    {
      "type": "custom",
      "format": "-----Hardware-----"
    },
    {
      "type": "cpu",
      "key": " CPU"
    },
    {
      "type": "memory",
      "key": "󰍛 memory"
    },
    {
      "type": "disk",
      "key": " disk"
    }
  ]
}
