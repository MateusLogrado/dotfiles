[global]
    # Fontes e espaçamento
    font = Monospace 10
    padding = 8
    horizontal_padding = 8
    frame_width = 2
    frame_color = "#db5353"

    # Layout
    width = 300
    height = 100
    offset = 30x30
    origin = top-right
    corner_radius = 0

[urgency_low]
    background = "#000000"
    foreground = "#ffffff"
    timeout = 5

[urgency_normal]
    background = "#000000"
    foreground = "#ffffff"
    timeout = 7

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#db5353"
    timeout = 0