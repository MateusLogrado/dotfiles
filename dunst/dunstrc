[global]
    # Fontes e espaçamento
    font = Terminus 10
    padding = 8
    horizontal_padding = 8
    frame_width = 2
    frame_color = "#EBDBB2"

    # Layout
    width = 300
    height = 100
    offset = 30x30
    origin = top-right
    corner_radius = 0

[urgency_low]
    background = "#1d2021"
    foreground = "#ebdbb2"
    timeout = 5

[urgency_normal]
    background = "#1d2021"
    foreground = "#ebdbb2"
    timeout = 7

[urgency_critical]
    background = "#1d2021"
    foreground = "#ebdbb2"
    frame_color = "#db5353"
    timeout = 0
